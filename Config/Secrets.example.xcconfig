// Copy this file to Config/Secrets.xcconfig and fill in your values.

// Must match the iOS app's bundle ID registered in your Firebase project.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.frij

// Your Apple developer team ID (Xcode > Settings > Accounts), needed to run on a device.
DEVELOPMENT_TEAM =

// REVERSED_CLIENT_ID from GoogleService-Info.plist.
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
